# ==========================================
# Anatomy-HyperFrames Video Environment Configuration
# ==========================================

# [Optional] Xiaomi MiMo TTS API Key for high-fidelity production voice synthesis.
# If omitted or left empty, the engine automatically uses Edge-TTS (free & zero-cost).
MIMO_API_KEY=

# [Optional] Explicit path to headless Chrome executable.
# If omitted, the engine dynamically locates the browser from local cache.
# HYPERFRAMES_BROWSER_PATH=

# [Optional] Audio acceleration rate for production audio (default: 1.0)
# MIMO_TEMPO=1.0
